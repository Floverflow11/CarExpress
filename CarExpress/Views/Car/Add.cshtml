@model CarAddViewModel

@{
    ViewData["Title"] = "Ajout";
}

<section>
    <div class="container text-center p-4 mt-5 m-4">
        <h1 class="display-6">Ajouter une voiture</h1>
        <p class="text-muted mb-4">tous les champs sont obligatoires</p>
        <div class="container text-start border-1 shadow p-5" style="max-width: 600px;">
            <form asp-controller="Car" asp-action="Add" method="post" enctype="multipart/form-data">
                <div class="mb-4">
                    <label asp-for="BoughtPrice" class="form-label">Prix d'achat</label>
                    <input asp-for="BoughtPrice" class="form-control" type="number"/>
                </div>
                <div class="mb-4">
                    <label asp-for="RepairCost" class="form-label">Coût des réparations</label>
                    <input asp-for="RepairCost" class="form-control" type="number"/>
                </div>
                <div class="mb-4">
                    <label asp-for="Year" class="form-label">Année</label>
                    <input asp-for="Year" class="form-control" type="number"/>
                </div>
                <div class="mb-4">
                    <label asp-for="Brand" class="form-label">Marque</label>
                    <input asp-for="Brand" class="form-control"/>
                </div>
                <div class="mb-4">
                    <label asp-for="Model" class="form-label">Modèle</label>
                    <input asp-for="Model" class="form-control"/>
                </div>
                <div class="mb-4">
                    <label asp-for="Trim" class="form-label">Finition</label>
                    <input asp-for="Trim" class="form-control"/>
                </div>
                <div class="mb-4">
                    <label asp-for="Image" class="form-label">Visuel</label>
                    <div class="border text-center border-black" style="min-height: 100px;">
                        <input type="file" asp-for="Image"/>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Publier</button>
            </form>
        </div>
    </div>
</section>