@using Microsoft.AspNetCore.Identity
@model CarDetailsViewModel
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model} {Model.Trim}";
}

<section>
    <div class="container p-4 mt-5 m-4">

        <a class="text-decoration-none" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Retour</a>

        <div class="card border-0 p-0 mt-5">
            <div class="row">
                <div class="col-md-7">
                    @if (Model.Pictures.Any())
                    {
                        <img src="~/@Model.Pictures.First().Path" class="img-fluid rounded-3"
                             alt="Voiture">
                    }
                    else
                    {
                        <img src="~/img/car_placeholder.jpeg" class="img-fluid rounded-3"
                             alt="Voiture">
                    }
                </div>
                <div class="col-md-5">
                    <div class="card-body">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="container p-0 mt-0 mb-4">
                                <span class="my-0 d-block">Vous avez publié cette annonce, vous pouvez le :</span>
        
                                <ul class="list-inline m-0 p-0">
                                    <li class="list-inline-item ps-0">
                                        <button class="btn btn-link ps-0 admin-modify">Modifier</button>
                                    </li>
                                    <li class="list-inline-item ps-0">
                                        <form asp-controller="Car" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                                            <button class="btn btn-link admin-delete">Supprimer</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        
                        <h5 class="card-title">@Model.Price</h5>
                        <ul class="list-inline">
                            <li>@Model.Year</li>
                            <li>@Model.Brand</li>
                            <li>@Model.Model</li>
                            <li>@Model.Trim</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>