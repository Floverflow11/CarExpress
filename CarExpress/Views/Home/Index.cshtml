@using Microsoft.AspNetCore.Identity
@model IEnumerable<CarViewModel>
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Express Voitures";
}

<section>
    <div class="container text-dark p-4 mt-5">
        <div class="container text-center py-4">
            <h1 class="display-6">Nos voitures</h1>
            @{
                if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Car" asp-action="Add" class="btn btn-primary my-3 py-3">+ Ajouter une voiture</a>
                }
            }
        </div>
        <div class="container text-start mt-5">
            <div class="row row-cols-2">
                @{
                    foreach (var view in Model)
                    {
                        <div class="col">
                            <div class="card border-0 p-0 m-4" style="max-width: 540px;">
                                <div class="row g-0 align-items-center">
                                    <div class="col-md-7">
                                        @if (view.Pictures.Any())
                                        {
                                            <img src="@view.Pictures.First().Path" class="img-fluid rounded-3" alt="Voiture">
                                        }
                                        else
                                        {
                                            <img src="~/img/car_placeholder.jpeg" class="img-fluid rounded-3" alt="Voiture">
                                        }
                                    </div>
                                    <div class="col-md-5">
                                        <div class="card-body">
                                            <h5 class="card-title">@view.Price</h5>
                                            <ul class="list-inline">
                                                <li>@view.Year</li>
                                                <li>@view.Brand</li>
                                                <li>@view.Model</li>
                                                <li>@view.Trim</li>
                                            </ul>
                                            <a asp-controller="Car" asp-action="Details" asp-route-id="@view.Id"
                                               class="stretched-link"></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>