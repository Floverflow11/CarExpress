@page
@model LoginModel

@{
    ViewData["Title"] = "Connexion";
}

<div class="container py-5" style="max-width: 400px;">
    <section>
        <form id="account" method="post">
            <h2 class="mb-5 text-center">Express Voitures</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Adresse email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Mot de passe</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                       aria-required="true"/>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="my-5 text-center">
                <button id="login-submit" type="submit" class="btn btn-primary py-2">Se connecter</button>
                <span class="mx-2">ou</span>
                <a class="btn btn-primary py-2" asp-page="./Register">S'inscrire</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}